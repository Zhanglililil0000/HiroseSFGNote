      "y": 285.2,
      "tex": "e_{a}=Œ -\\sin \\chi \\cos \\phi \\cos \\theta -\\cos \\chi \\sin \\phi œ 、"
    },
    {
      "y": 300.2,
      "tex": "º Œ \\cos \\phi \\sin \\theta ß œ"
    },
    {
      "y": 320.2,
      "tex": "Ø \\cos \\chi \\sin \\phi \\cos \\theta +\\sin \\chi \\cos \\phi ø"
    },
    {
      "y": 335.2,
      "tex": "e_{b}=Œ -\\sin \\chi \\sin \\phi \\cos \\theta +\\cos \\chi \\cos \\phi œ 、"
    },
    {
      "y": 350.2,
      "tex": "º Œ \\sin \\phi \\sin \\theta ß œ"
    },
    {
      "y": 369.2,
      "tex": "Ø -\\cos \\chi \\sin \\theta ø"
